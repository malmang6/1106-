# ==========================================
# 공모전 플랫폼 환경변수 설정 예시 파일 (.env.example)
# 실제 키 값을 넣은 파일은 '.env.local'로 생성해야 하며,
# 절대로 GitHub 등 공개 저장소에 커밋/푸시하지 마십시오.
# ==========================================

# 1. Airtable 설정
# Airtable Personal Access Token (data.records:read, data.records:write 권한 필요)
# 발급처: https://airtable.com/create/tokens
AIRTABLE_API_KEY=patXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Airtable Base ID (브라우저 주소창 https://airtable.com/app... 에서 확인)
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Airtable Table Name (기본 테이블 이름: Submissions)
AIRTABLE_TABLE_NAME=Submissions

# 2. Google Gemini API 설정
# Google AI Studio에서 발급받은 API 키 (Gemini 3.8 Flash 활용)
# 발급처: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
